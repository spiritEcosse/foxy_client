# Base URL of the backend API (no trailing slash).
# Requests are built as ${VITE_APP_SERVER_URL}/api/v1/...
VITE_APP_SERVER_URL=http://localhost:8000

# Google OAuth client ID for sign-in.
VITE_APP_GOOGLE_CLIENT_ID=

# Google Pay environment: TEST or PRODUCTION.
VITE_APP_GOOGLE_PAY_ENV=TEST

# Sentry DSN for error/performance reporting (leave empty to disable).
VITE_APP_SENTRY_DSN=

# TwicPics account name for image delivery.
VITE_APP_TWIC_PICS_NAME=

# Contact email shown in the UI (footer, privacy policy).
VITE_APP_CONTACT_EMAIL=
